# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# In CI, these come from GitHub Actions secrets, not from a file.

# --- Model providers (set only the ones you use) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Local inference — no key needed
OLLAMA_BASE_URL=http://localhost:11434

# --- Agent configuration ---
# Model used for scored eval runs
RCA_MODEL=gemini/gemini-2.0-flash
# Cheaper/faster model for the dev loop
RCA_DEV_MODEL=ollama/qwen3:4b

# Hard ceiling per run, enforced before the call is made (USD)
RCA_MAX_COST_PER_RUN=0.25
# Daily spend ceiling for the whole app; fails closed when exceeded (USD)
RCA_DAILY_BUDGET=2.00
